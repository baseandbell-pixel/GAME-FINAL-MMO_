--- !u!114 &7080096089718822649
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3163640108653665811}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<color=#FFD166><b>MOVEMENT & EXPLORATION</b></color>\n  \u2022  <b>WASD</b>
    \u2014 Move   |   <b>Space</b> \u2014 Jump   |   <b>C</b> \u2014 Crouch / Stealth\n 
    \u2022  <b>Left Shift</b> \u2014 Sprint (FREE Stamina in Safe Zone & Out-of-Combat!)\n 
    \u2022  <b>Left Ctrl</b> \u2014 Dodge Roll (i-frames)   |   <b>V</b> \u2014 Toggle
    Camera View\n\n<color=#FFD166><b>COMBAT (SOULS-LIKE GREATSWORD)</b></color>\n 
    \u2022  <b>[1]</b> \u2014 Draw / Sheathe GreatSword (Must draw outside Safe Zone
    to attack!)\n  \u2022  <b>Left Click (LMB)</b> \u2014 Light Combo 1-2-3 (Hit
    3 = CRIT Finisher)\n  \u2022  <b>Right Click (RMB) / [R]</b> \u2014 Heavy Slash
    (Guard Break)\n  \u2022  <b>[F]</b> \u2014 Block (75% Reduction) / Tap on Impact
    for Perfect Parry & Stagger\n  \u2022  <b>Middle Click (MMB)</b> \u2014 Lock-On
    Target   |   <b>[2\u20137]</b> \u2014 Hotbar Potions & Buffs\n\n<color=#42F5C8><b>INTERACTION,
    FAST TRAVEL & CO-OP PARTY</b></color>\n  \u2022  <b>[E]</b> \u2014 Pick up Loot
    / Open Treasure Chest / Attune & Warp at Waystones\n  \u2022  <b>[G]</b> \u2014
    Talk to Quest NPCs   |   <b>Hold [G] (2.5s)</b> \u2014 Revive Downed Ally\n 
    \u2022  <b>[P]</b> \u2014 Co-op Party Roster & Invite (Accept [Y] / Decline [N])\n 
    \u2022  <b>[I] / [Tab]</b> \u2014 Inventory, Stats & Blacksmith   |   <b>[M]</b>
    \u2014 World Map (Click Unlocked Waystone to Warp)\n  \u2022  <b>[J]</b> \u2014
    Item Guide   |   <b>[H]</b> \u2014 Toggle This Guide   |   <color=#9EB0C4>(Q
    / E reserved for future Skills)</color>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
